          "match": {
            "type": "equals",
            "expected": "Days until harvest: Day 1\nDay 2\nDay 3\nDay 4\nDay 5\nHarvest time!"
          }
        },
        {
          "name": "1 days",
          "mode": "func_stdio",
          "func": "ft_count_harvest_recursive",
          "stdin": "1\n",
          "match": {
            "type": "equals",
            "expected": "Days until harvest: Day 1\nHarvest time!"
          }
