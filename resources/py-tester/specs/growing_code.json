            "type": "equals",
            "expected": "Days until harvest: Day 1\nDay 2\nDay 3\nDay 4\nDay 5\nDay 6\nDay 7\nDay 8\nDay 9\nDay 10\nDay 11\nDay 12\nHarvest time!"
          }
        }
      ]
    },
    {
      "id": "ex7",
      "title": "Seed Inventory (typed)",
      "file": "ex7/ft_seed_inventory.py",
      "authorized": [
        "print"
      ],
      "only_functions": true,
      "typed": true,
      "tests": [
        {
          "name": "packets unit",
          "mode": "func_stdio",
          "func": "ft_seed_inventory",
          "match": {
            "type": "equals",
            "expected": "Tomato seeds: 15 packets available"
          },
          "args": [
            "tomato",
            15,
            "packets"
          ]
        },
        {
          "name": "grams unit",
          "mode": "func_stdio",
          "func": "ft_seed_inventory",
          "match": {
            "type": "equals",
            "expected": "Carrot seeds: 8 grams total"
          },
          "args": [
            "carrot",
            8,
            "grams"
          ]
        },
        {
          "name": "area unit",
          "mode": "func_stdio",
          "func": "ft_seed_inventory",
          "match": {
            "type": "equals",
            "expected": "Lettuce seeds: covers 12 square meters"
          },
          "args": [
            "lettuce",
            12,
            "area"
          ]
        },
        {
          "name": "unknown unit",
          "mode": "func_stdio",
          "func": "ft_seed_inventory",
          "match": {
            "type": "equals",
            "expected": "Unknown unit type"
          },
          "args": [
            "basil",
            3,
            "tons"
          ]
        },
        {
          "name": "already capitalized / multi-letter",
          "mode": "func_stdio",
          "func": "ft_seed_inventory",
          "match": {
            "type": "equals",
            "expected": "Sunflower seeds: 100 packets available"
          },
          "args": [
            "SUNFLOWER",
            100,
            "packets"
          ]
        }
      ]
    }
  ]
}
