    {
      "id": "ex4",
      "title": "Garden Security System",
      "file": "ex4/ft_garden_security.py",
      "authorized": [
        "print",
        "range",
        "round"
      ],
      "typed": true,
      "tests": [
        {
          "name": "runs and rejects a negative value",
          "mode": "script",
          "match": {
            "exit_code": 0,
            "stdout": {
              "type": "in_order",
              "items": [
                "=== Garden Security System ===",
                "rejected"
              ]
            },
            "stderr": {
              "type": "python",
              "code": [
                "assert 'Traceback' not in out, 'crashed: ' + lines[-1]"
              ]
            }
          }
        },
        {
          "name": "setters validate, getters read, data is protected",
          "mode": "module",
          "code": [
            "p = m.Plant('Rose', 15.0, 10)",
            "for name in vars(p):",
            "    assert name.startswith('_'), 'attribute %r is not protected' % name",
            "    assert '__' not in name, '%r uses name mangling, the subject wants _protected' % name",
            "capture(p.set_height, 25)",
            "capture(p.set_age, 30)",
            "assert p.get_height() == 25, 'set_height(25) did not apply'",
            "assert p.get_age() == 30, 'set_age(30) did not apply'",
            "out, _ = capture(p.set_height, -5)",
            "assert p.get_height() == 25, 'set_height(-5) changed the height'",
            "assert out.strip(), 'set_height(-5) printed no error'",
            "out, _ = capture(p.set_age, -5)",
            "assert p.get_age() == 30, 'set_age(-5) changed the age'",
            "assert out.strip(), 'set_age(-5) printed no error'",
            "out, err = capture(m.Plant, 'Bad', -1.0, -1)",
            "assert err is None, 'creating a bad plant raised %r' % err",
            "assert out.strip(), 'creating a plant with negative values printed no error'"
          ]
        }
      ]
    },
